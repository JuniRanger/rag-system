# Ollama
# Deja OLLAMA_BASE_URL vacío para auto-detect:
#   - máquina local  → OLLAMA_BASE_URL_LOCAL
#   - contenedor     → OLLAMA_BASE_URL_DOCKER
# Si defines OLLAMA_BASE_URL, esa URL gana siempre (override manual).
OLLAMA_BASE_URL=
OLLAMA_BASE_URL_LOCAL=http://localhost:11434
OLLAMA_BASE_URL_DOCKER=http://172.17.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_MODEL_FALLBACK=llama3.2:1b
OLLAMA_KEEP_ALIVE=24h

# Qdrant Cloud (obligatorio: URL y API key del cluster)
# Ejemplo URL: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Reranker (CrossEncoder local; no usa Ollama)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=16
# Vacío = auto (cuda → mps → cpu)
RERANKER_DEVICE=

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=10

# App
DEBUG=False
PROVIDER_TYPE=LOCAL

# Supabase (ingesta desde tabla + webhook)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_TABLE=documentos_tecnicos
SUPABASE_ID_COLUMN=id
SUPABASE_CURSOR_COLUMN=id
# Columnas de texto a indexar (solo estas se ingestan), separadas por coma
SUPABASE_TEXT_COLUMNS=vehiculo_marca,vehiculo_modelo,categoria_problema,problema,diagnostico,solucion
# Secreto que Supabase enviará en el header X-Webhook-Secret
SUPABASE_WEBHOOK_SECRET=un_secreto_largo_y_aleatorio
# Opcional: proteger POST /api/v1/sync con header X-Sync-Secret
SUPABASE_SYNC_SECRET=
# Tool calling en respuestas RAG (Supabase + crearCitaAPI durante /query).
# false: webhook/sync activos; /query/stream habilitado.
# true: /query usa function calling (citas + consultas); /query/stream limitado.
ENABLE_RAG_TOOLS=true

# API externa para agendar citas (crearCitaAPI)
CITAS_API_BASE_URL=https://lacasadelosfrenos-api.onrender.com
